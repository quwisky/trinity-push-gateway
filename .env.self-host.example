TRINITY_PUSH_GATEWAY_VERSION=v0.1.0
TRINITY_PUSH_GATEWAY_ANDROID_APP_ID=ovh.qwky.trinity.android
TRINITY_PUSH_GATEWAY_IOS_APP_ID=ovh.qwky.trinity.ios
TRINITY_PUSH_GATEWAY_TRUSTED_PROXY_CIDRS=
TRINITY_PUSH_GATEWAY_CLIENT_IP_HEADER=x-forwarded-for
TRINITY_PUSH_GATEWAY_HOST_PORT=3000
TRINITY_PUSH_GATEWAY_PORT=3000

# Optional host paths for Compose secret sources.
TRINITY_PUSH_GATEWAY_FCM_CLIENT_EMAIL_FILE=./secrets/fcm_client_email
TRINITY_PUSH_GATEWAY_FCM_PRIVATE_KEY_FILE=./secrets/fcm_private_key
TRINITY_PUSH_GATEWAY_FCM_PROJECT_ID_FILE=./secrets/fcm_project_id
TRINITY_PUSH_GATEWAY_FINGERPRINT_KEY_FILE=./secrets/fingerprint_key
