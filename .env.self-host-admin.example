# Use with both compose.yml and compose.admin.yml. The base Compose file stays
# administration-disabled and does not require these settings or secret files.
TRINITY_PUSH_GATEWAY_ADMIN_ENABLED=true
TRINITY_PUSH_GATEWAY_ADMIN_PUBLIC_ORIGIN=https://push.example.com
TRINITY_PUSH_GATEWAY_ADMIN_OIDC_CLIENT_ID=trinity-push-gateway
TRINITY_PUSH_GATEWAY_ADMIN_OIDC_REQUIRED_GROUP=push-gateway-operators
TRINITY_PUSH_GATEWAY_ADMIN_OIDC_CLIENT_SECRET_FILE=./secrets/admin_oidc_client_secret
TRINITY_PUSH_GATEWAY_ADMIN_SESSION_SECRET_FILE=./secrets/admin_session_secret

# Pocket ID defaults. Register the exact callback
# https://push.example.com/admin/auth/callback and use the groups scope.
TRINITY_PUSH_GATEWAY_ADMIN_OIDC_ISSUER=https://id.example.com
TRINITY_PUSH_GATEWAY_ADMIN_OIDC_SCOPES=openid profile email groups
TRINITY_PUSH_GATEWAY_ADMIN_OIDC_GROUP_CLAIM=groups
TRINITY_PUSH_GATEWAY_ADMIN_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic

# Authentik alternative. Its application slug is part of the issuer URL and
# the groups claim is included through the provider's profile scope mapping.
# TRINITY_PUSH_GATEWAY_ADMIN_OIDC_ISSUER=https://auth.example.com/application/o/trinity-push-gateway/
# TRINITY_PUSH_GATEWAY_ADMIN_OIDC_SCOPES=openid profile email
# TRINITY_PUSH_GATEWAY_ADMIN_OIDC_GROUP_CLAIM=groups
# TRINITY_PUSH_GATEWAY_ADMIN_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
