{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trinity-push-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "limits": {
    "cpu_ms": 10,
    "subrequests": 50,
  },
  "vars": {
    "ANDROID_APP_ID": "ovh.qwky.trinity.android",
    "IOS_APP_ID": "ovh.qwky.trinity.ios",
    "MAX_BODY_BYTES": "65536",
    "MAX_DAILY_ATTEMPTS": "20000",
    "MAX_DEVICES": "49",
    "PENDING_LEASE_SECONDS": "120",
    "TERMINAL_RETENTION_SECONDS": "86400",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trinity-push-gateway",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "SOURCE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 10,
      },
    },
  ],
  "triggers": {
    "crons": ["0 3 * * *"],
  },
}
