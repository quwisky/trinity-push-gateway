{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trinity-push-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      // Placeholder. Replace with the ID of your own namespace
      // (`wrangler kv namespace create TOKENS`); see the README.
      "id": "00000000000000000000000000000000",
    },
  ],
  "vars": {
    "APPS": {
      "eu.qwky.trinity.android": { "kind": "fcm" },
      "eu.qwky.trinity.ios": { "kind": "fcm" },
    },
  },
  "ratelimits": [
    {
      "name": "PUSHKEY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
