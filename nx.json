{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      { "runtime": "node --version" },
      { "runtime": "pnpm --version" }
    ],
    "sharedGlobals": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "build-bun": {
      "cache": true,
      "inputs": ["default", { "runtime": "bun --version" }]
    },
    "check-bundle": {
      "cache": true,
      "dependsOn": ["build"]
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "test-bun": {
      "cache": true,
      "inputs": ["default", { "runtime": "bun --version" }]
    },
    "test-coverage": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "typecheck-bun": {
      "cache": true
    }
  }
}
