{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      {
        "runtime": "node --version"
      },
      {
        "runtime": "pnpm --version"
      }
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/.github/workflows/container.yml",
      "{workspaceRoot}/.github/workflows/pages.yml",
      "{workspaceRoot}/.husky/pre-commit",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/compose.yml",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/lint-staged.config.mjs",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "build-bun": {
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "bun --version"
        }
      ]
    },
    "check-bundle": {
      "cache": true,
      "dependsOn": ["build"]
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "test-bun": {
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "bun --version"
        }
      ]
    },
    "test-coverage": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "typecheck-bun": {
      "cache": true
    },
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": ["default", "^default"]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    }
  ],
  "analytics": false,
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "inlineStyle": false,
      "inlineTemplate": false,
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:component": {
      "inlineStyle": false,
      "inlineTemplate": false,
      "style": "scss"
    }
  }
}
